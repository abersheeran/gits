{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gits",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REPOSITORY_OBJECTS",
				"class_name": "RepositoryObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "repository-object-v1",
			"new_sqlite_classes": [
				"RepositoryObject"
			]
		}
	],
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "GIT_BUCKET",
			"bucket_name": "gits"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gits",
			"database_id": "7c420328-21e3-409d-89f6-a3d50433d822",
			"migrations_dir": "src/db/migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
