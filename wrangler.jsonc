{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gits",
	"main": "src/index.ts",
	"triggers": { "crons": ["*/5 * * * *"] },
	"limits": { "cpu_ms": 300000 },
	"compatibility_date": "2026-02-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REPOSITORY_OBJECTS",
				"class_name": "RepositoryObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "repository-object-v1",
			"new_sqlite_classes": [
				"RepositoryObject"
			]
		}
	],
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "GIT_BUCKET",
			"bucket_name": "gits"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gits",
			"database_id": "7c420328-21e3-409d-89f6-a3d50433d822",
			"migrations_dir": "src/db/migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "gits-preview",
				"database_id": "05f28c85-89bc-4ba2-8ce9-fa8116b1ee61",
				"migrations_dir": "src/db/migrations"
			}
		],
		"r2_buckets": [
			{
				"binding": "GIT_BUCKET",
				"bucket_name": "gits-preview"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "REPOSITORY_OBJECTS",
					"class_name": "RepositoryObject"
				}
			]
		},
		"vars": {
			"ALLOW_USER_REGISTRATION": "true"
		}
	}
}
